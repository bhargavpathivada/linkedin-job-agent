# Telegram — @whobatbot (message /start first, then run scripts/get_telegram_chat_id.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail SMTP — MUST be a Google App Password (16 chars), NOT your normal password.
# Used by the personal CLI agent AND SaaS payment-approval emails to users.
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords → Mail → Other
# 3. Paste the 16-character password below (spaces OK)
GMAIL_ADDRESS=letittapply@gmail.com
GMAIL_APP_PASSWORD=

# Where Google Form / pending job alerts are emailed (separate subjects: [Form] vs [Pending]).
FORM_NOTIFY_EMAIL=uppalaakash2004@gmail.com

# Optional: Ollama vision model for flyer images when tesseract misses text
# (e.g. llama3.2-vision). Leave empty to use tesseract only.
# OLLAMA_VISION_MODEL=

# 0 = send emails immediately (default). 1 = Telegram preview only.
DRY_RUN=0

# Optional
# minimized = background Chrome off-screen (recommended). headless often gets 0 LinkedIn posts.
LINKEDIN_BROWSER_MODE=minimized
# Hide Chrome window during scrape (macOS). Set 0 to show browser for debugging.
LINKEDIN_HIDE_CHROME=1
LINKEDIN_USE_CHROME=1
SEARCH_DELAY_SEC=15
SCROLL_COUNT=24
MAX_POSTS_PER_SEARCH=80
# Scheduler interval in seconds (1800 = every 30 minutes)
SCHEDULE_INTERVAL_SEC=1800
MAX_YEARS_EXPERIENCE=3

# ── LetItApply SaaS (jobsearch_saas) ───────────────────────────
SAAS_APP_NAME=LetItApply
SAAS_ENV=development
SAAS_SECRET_KEY=dev-only-change-me
SAAS_BASE_URL=http://127.0.0.1:8000
SAAS_SUPPORT_EMAIL=support@letitapply.com
# SAAS_LEGAL_ENTITY=LetItApply
# SAAS_DATABASE_URL=sqlite:////absolute/path/to/data/saas.db
# SAAS_TOKEN_FERNET_KEY=  # optional Fernet key; derived from SAAS_SECRET_KEY if empty
# SAAS_GST_RATE=0.18
# SAAS_PRICES_INCLUDE_GST=0

# Google OAuth for SaaS Gmail connect (never ask SaaS users for app passwords)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/settings/email/callback

# Razorpay one-time passes (leave empty for local dev_bypass checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Companion / Electron
# LETITAPPLY_API=http://127.0.0.1:8000
# SAAS_COMPANION_TOKEN_DAYS=30
# SAAS_COMPANION_DOWNLOAD_URL=http://127.0.0.1:8000/download

# Set to 1 only for local/private beta — never on public production
# SAAS_ALLOW_BETA_GRANT=0

# MongoDB Atlas / self-hosted — used for durable SaaS storage (required on Vercel)
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/letitapply?retryWrites=true&w=majority
# SAAS_FORCE_SQLITE=1  # tests / local override when MONGO_URI is also set


# GOOGLE_AUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# GOOGLE_ADMIN_REDIRECT_URI=http://127.0.0.1:8000/admin/callback
